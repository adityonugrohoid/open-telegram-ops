# Delivery-ops MCP server, built as a standalone sidecar that serves the
# delivery-ops tools over streamable-http. Kept separate from the OpenClaw gateway image so
# each upgrades independently (the gateway stays on the stock pinned image).
# See openclaw/DEPLOYMENT.md.

FROM python:3.12-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY delivery_ops_mcp ./delivery_ops_mcp
# Bundle only the budget seed script (not the OCR test harness) so the documented
# `python -m scripts.seed_budget` chart-of-accounts load works inside the sidecar.
COPY scripts/__init__.py scripts/seed_budget.py ./scripts/

ENV MCP_TRANSPORT=streamable-http \
    MCP_HTTP_HOST=0.0.0.0 \
    MCP_HTTP_PORT=8000

EXPOSE 8000

CMD ["python", "-m", "delivery_ops_mcp.server"]
