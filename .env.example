# Copy to .env and fill in. Never commit .env.
#
# NOTE: the Azure path below is retired (torn down 2026-06-13). Production moved to
# the open-claude repo on AWS. Kept here for reference / historical reproduction.

# === Telegram (consumed by OpenClaw) ===
# Bot token from @BotFather.
TELEGRAM_BOT_TOKEN=

# === LLM: Azure OpenAI (chat + agents, Path B built-in openai-compatible provider) ===
# Static key + the OpenAI-compatible v1 endpoint of your Azure OpenAI resource.
# Fetch both with the az commands in openclaw/AZURE-HANDOFF.md. The base URL is the
# resource endpoint with /openai/v1/ appended (no api-version needed). gpt-5-mini and
# o4-mini are reasoning-family models served here over chat-completions.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_BASE_URL=https://YOUR-OAI-RESOURCE.openai.azure.com/openai/v1/

# === OCR: Azure AI Foundry (Mistral Document AI) ===
# A dedicated OCR API on an AIServices-kind account, NOT the openai/v1 surface.
# Call route: ${AZURE_AI_FOUNDRY_ENDPOINT}providers/mistral/azure/ocr (Bearer auth).
# Used by scripts/ocr_test/run_ocr_test.py (the OCR gate). Fetch with the az commands
# in openclaw/AZURE-HANDOFF.md.
AZURE_AI_FOUNDRY_ENDPOINT=https://YOUR-AIS-RESOURCE.cognitiveservices.azure.com/
AZURE_AI_FOUNDRY_API_KEY=

# === Deployment names (Azure calls the deployment, not the base model name) ===
# These must match the deployment names in Azure and the model ids in openclaw.json.
LLM_MODEL=gpt-5-mini
REASONING_MODEL=o4-mini
OCR_MODEL=mistral-document-ai-2512

# === Delivery-ops ledger (the MCP server we own) ===
# Local/demo: data/delivery_ops.db. Container/sidecar: /data/delivery_ops.db (set in compose).
DELIVERY_OPS_DB_PATH=data/delivery_ops.db

# Single pilot project for v0. No multi-project routing yet.
PROJECT_NAME=

# Comma-separated Telegram user IDs allowed to run manager query commands
# (/spend, /budget). Empty means any bot user can query (decide before pilot).
MANAGER_TELEGRAM_IDS=

# Transport for the MCP server: "stdio" (local/demo) or "streamable-http" (sidecar).
MCP_TRANSPORT=stdio
MCP_HTTP_HOST=0.0.0.0
MCP_HTTP_PORT=8000

# === OpenClaw 24/7 deploy (Docker). See openclaw/DEPLOYMENT.md ===
# Pin the stable version. Never float to :latest on a client box.
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:2026.5.28
# Generate with: openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=
# Published on loopback only; reach it via Tailscale or SSH tunnel.
OPENCLAW_GATEWAY_PORT=18789
